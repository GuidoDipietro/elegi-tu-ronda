# Supabase Connect > Transaction pooler. Never use a VITE_ prefix for secrets.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Required for hosted Supabase connections; local Postgres can omit this.
PGSSLMODE=verify-full
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: a separate disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=
